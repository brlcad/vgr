#!/usr/bin/expect -f
set timeout -1
set simh $env(VGR_SIMH_BIN)
set ini $env(VGR_SIMH_INI)
set mode $env(VGR_MODE)
set results $env(VGR_RESULTS)
set send_slow {1 .01}

if {$mode eq "benchmark" || $mode eq "collect"} {
    set stamp [clock format [clock seconds] -format "%Y%m%d-%H%M%S"]
    log_file -noappend "$results/vgr-$stamp.console.log"
}

spawn $simh -q $ini
expect {
    -re {Invalid argument} {
        puts stderr "SIMH rejected a generated configuration command"
        exit 2
    }
    -re {Boot[\r\n]+} {}
}
expect -re {: $}
send -s -- "ra(0,0)vmunix\r"
expect "root device?"
send -s -- "ra0\r"
expect -re {# $}
send -s -- "fsck -p\r"
expect -re {# $}
send -s -- "mount -a\r"
expect -re {# $}

if {$mode eq "shell"} {
    interact
    exit 0
}

send -s -- "BRLCAD_ROOT=/usr/brlcad; export BRLCAD_ROOT\r"
expect -re {# $}
send -s -- "PATH=/usr/brlcad/bin:/usr/local/bin:/bin:/usr/bin:/usr/ucb\r"
expect -re {# $}
send -s -- "export PATH\r"
expect -re {# $}
send -s -- "cd /usr/src/brlcad-4.6/bench\r"
expect -re {# $}

if {$mode eq "benchmark"} {
    send -s -- "sh ./run.sh\r"
    expect -re {# $}
}

foreach scene {moss world star bldg391 m35 sphflake} {
    send -s -- "echo VGR-BEGIN $scene; grep pixels $scene.log; grep RTFM $scene.log; echo VGR-END $scene\r"
    expect -re {# $}
}
send -s -- "sync\r"
expect -re {# $}
send -s -- "\005"
expect "sim> "
send -s -- "quit\r"
expect eof
